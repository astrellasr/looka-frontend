# Backend API base URL. Already includes /api, so frontend calls are
# written as '/auth/login', never '/api/auth/login'.
VITE_API_BASE_URL=http://localhost:5001/api

# TEMPORARY: frontend preview mode.
# true  - authentication is simulated in the browser; every page is
#         reachable with no backend running. Used while the UI is
#         being finalised.
# false - the real JWT flow against the backend above.
VITE_FRONTEND_PREVIEW=true
